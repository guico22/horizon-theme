{%- doc -%}
  Announcement with a first-purchase coupon code and a copy button.
  `[cupom]` in the text is replaced by the code; when the text has no
  `[cupom]`, the code is shown after the text.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign coupon_code = block_settings.coupon_code | strip
  assign block_index = section.blocks | find_index: 'id', block.id

  capture coupon_html
    echo '<strong class="announcement-coupon__code">'
    echo coupon_code | escape
    echo '</strong>'
  endcapture

  assign coupon_text = block_settings.text | escape
  if coupon_text contains '[cupom]'
    assign coupon_text = coupon_text | replace: '[cupom]', coupon_html
  elsif coupon_code != blank
    assign coupon_text = coupon_text | append: ' ' | append: coupon_html
  endif
-%}

{%- if block_settings.text != blank -%}
  <slideshow-slide
    ref="slides[]"
    class="announcement-bar__slide announcement-coupon"
    style="{% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb }};{% endif %}"
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    <p class="announcement-bar__text announcement-coupon__text">
      {{ coupon_text }}
    </p>

    {%- if block_settings.show_copy_button and coupon_code != blank -%}
      <script
        src="{{ 'coupon-copy.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
      <coupon-copy
        class="announcement-coupon__copy"
        data-code="{{ coupon_code | escape }}"
        data-copied-label="{{ block_settings.copied_label | escape }}"
      >
        <button
          type="button"
          class="announcement-coupon__button"
        >
          <span data-coupon-copy-label>{{ block_settings.copy_label | escape }}</span>
          <span class="visually-hidden">: {{ coupon_code | escape }}</span>
        </button>
        <span
          class="visually-hidden"
          role="status"
          data-coupon-copy-status
        ></span>
      </coupon-copy>
    {%- endif -%}
  </slideshow-slide>
{%- endif -%}

{% stylesheet %}
  .announcement-coupon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 12px;
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm);
    line-height: 1.3;
    text-align: center;
    color: var(--color, var(--color-foreground));
  }

  .announcement-coupon__text {
    margin: 0;
  }

  .announcement-coupon__code {
    padding: 1px 6px;
    border: 1px dashed currentColor;
    border-radius: 4px;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .announcement-coupon__copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .announcement-coupon__button {
    padding: 2px 10px;
    min-height: 24px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    color: inherit;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 999px;
    cursor: pointer;
  }

  .announcement-coupon__button:hover {
    background-color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-15));
  }

  .announcement-coupon__button[data-copied] {
    background-color: var(--color, var(--color-foreground));
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cupom de primeira compra",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "info": "[cupom] é substituído pelo código.",
      "default": "Primeira compra? Use o cupom [cupom]"
    },
    {
      "type": "text",
      "id": "coupon_code",
      "label": "Código do cupom",
      "info": "Precisa existir em Descontos, senão o checkout recusa o código.",
      "default": "SEUCUPOM"
    },
    {
      "type": "checkbox",
      "id": "show_copy_button",
      "label": "Mostrar botão de copiar",
      "default": true
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Texto do botão",
      "default": "Copiar",
      "visible_if": "{{ block.settings.show_copy_button }}"
    },
    {
      "type": "text",
      "id": "copied_label",
      "label": "Texto após copiar",
      "default": "Copiado!",
      "visible_if": "{{ block.settings.show_copy_button }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color"
    }
  ],
  "presets": [
    {
      "name": "Cupom de primeira compra"
    }
  ]
}
{% endschema %}
