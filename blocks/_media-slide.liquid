{% assign block_settings = block.settings %}
{%- assign block_index = section.blocks | find_index: 'id', block.id -%}
{%- assign section_index = section.index -%}

{% liquid
  assign media_type = 'none'
  assign media_type_mobile = 'none'
  assign fallback_to_desktop = false

  # Desktop media checks
  if block_settings.image != blank and block_settings.media_type == 'image'
    assign media_type = 'image'
  endif
  if block_settings.video != blank and block_settings.media_type == 'video'
    assign media_type = 'video'
  endif

  # Mobile media checks
  if block_settings.custom_mobile_media
    if block_settings.image_mobile != blank and block_settings.media_type_mobile == 'image'
      assign media_type_mobile = 'image'
    endif
    if block_settings.video_mobile != blank and block_settings.media_type_mobile == 'video'
      assign media_type_mobile = 'video'
    endif
  endif

  # Fallback to desktop if no mobile media is set
  if block_settings.custom_mobile_media == false or media_type_mobile == 'none'
    assign fallback_to_desktop = true
    assign media_type_mobile = media_type
  endif

  # Desktop classes - also apply to mobile if fallback is active
  assign media_image_desktop_class = 'media-slide__image media-slide__image--desktop'
  assign media_video_desktop_class = 'media-slide__video media-slide__video--desktop'
  assign video_wrapper_desktop_class = 'media-slide__video-wrapper media-slide__video-wrapper--desktop'

  if fallback_to_desktop
    assign media_image_desktop_class = media_image_desktop_class | append: ' media-slide__image--mobile'
    assign media_video_desktop_class = media_video_desktop_class | append: ' media-slide__video--mobile'
    assign video_wrapper_desktop_class = video_wrapper_desktop_class | append: ' media-slide__video-wrapper--mobile'
  endif

  # Responsive image sizes
  assign widths = '832, 1200, 1600, 1920, 2560, 3840'
  assign mobile_widths = '416, 600, 800, 1200, 1600'
  assign mobile_widths_array = mobile_widths | split: ', '
  assign sizes = '100vw'
  assign sizes_mobile = '100vw'

  # Loading and fetch priority
  assign loading = 'lazy'
  if block_index == 0 and section_index <= 3
    assign loading = 'eager'
  endif

  assign fetch_priority = 'auto'
  if block_index == 0 and section_index == 1
    assign fetch_priority = 'high'
  endif

  # Preview image for aspect ratio calculation
  assign preview_image = block_settings.image
  if block_settings.media_type == 'video' and block_settings.video.preview_image != blank
    assign preview_image = block_settings.video.preview_image
  endif
%}

{% capture children %}
  {% if section.settings.slide_height == 'adapt_image' and block_index == 0 and preview_image != blank %}
    {% style %}
      .shopify-section-{{ section.id }} slideshow-slides,
      .shopify-section-{{ section.id }} slideshow-slide {
        min-height: {{ 1 | divided_by: preview_image.aspect_ratio | times: 100 }}vw;
      }
    {% endstyle %}
  {% endif %}

  <div class="media-slide__media-container">
    {%- if block_settings.toggle_overlay -%}
      {% render 'overlay', settings: block_settings %}
    {%- endif -%}

    {%- comment -%} Desktop Media {%- endcomment -%}
    {%- if media_type == 'image' and media_type_mobile == 'image' and fallback_to_desktop == false -%}
      {%- comment -%} Both desktop and mobile are images - use picture element for art direction {%- endcomment -%}
      <picture class="media-slide__image" data-testid="media-slide-picture">
        <source
          media="(max-width: 749px)"
          srcset="
            {%- for mobile_width in mobile_widths_array -%}
              {{ block_settings.image_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          "
          sizes="{{ sizes_mobile }}"
          width="{{ block_settings.image_mobile.width }}"
          height="{{ block_settings.image_mobile.height }}"
        >
        {{
          block_settings.image
          | image_url: width: 3840
          | image_tag:
            width: block_settings.image.width,
            widths: widths,
            height: block_settings.image.height,
            alt: block_settings.image.alt,
            class: 'media-slide__image',
            sizes: sizes,
            fetchpriority: fetch_priority,
            loading: loading,
            data-testid: 'media-slide-desktop-image'
        }}
      </picture>
    {%- elsif media_type == 'image' -%}
      {{
        block_settings.image
        | image_url: width: 3840
        | image_tag:
          width: block_settings.image.width,
          widths: widths,
          height: block_settings.image.height,
          alt: block_settings.image.alt,
          class: media_image_desktop_class,
          sizes: sizes,
          fetchpriority: fetch_priority,
          loading: loading,
          data-testid: 'media-slide-desktop-image'
      }}
    {%- endif -%}

    {%- if media_type == 'video' -%}
      <div class="{{ video_wrapper_desktop_class }}">
        {%- if block_settings.video.preview_image -%}
          {{
            block_settings.video.preview_image
            | image_url: width: 3840
            | image_tag:
              width: block_settings.video.preview_image.width,
              widths: widths,
              height: block_settings.video.preview_image.height,
              loading: loading,
              class: 'media-slide__video-poster media-slide__video-poster--desktop',
              fetchpriority: fetch_priority
          }}
        {%- endif -%}
        {{
          block_settings.video
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            class: media_video_desktop_class,
            data-testid: 'media-slide-desktop-video'
        }}
      </div>
    {%- endif -%}

    {%- comment -%} Mobile-only media (when desktop is different type) {%- endcomment -%}
    {%- if fallback_to_desktop == false -%}
      {%- if media_type_mobile == 'image' and media_type != 'image' -%}
        {{
          block_settings.image_mobile
          | image_url: width: 1600
          | image_tag:
            width: block_settings.image_mobile.width,
            widths: mobile_widths,
            height: block_settings.image_mobile.height,
            alt: block_settings.image_mobile.alt,
            class: 'media-slide__image media-slide__image--mobile',
            sizes: sizes_mobile,
            fetchpriority: fetch_priority,
            loading: loading,
            data-testid: 'media-slide-mobile-image'
        }}
      {%- endif -%}

      {%- if media_type_mobile == 'video' -%}
        <div class="media-slide__video-wrapper media-slide__video-wrapper--mobile">
          {%- if block_settings.video_mobile.preview_image -%}
            {{
              block_settings.video_mobile.preview_image
              | image_url: width: 1600
              | image_tag:
                width: block_settings.video_mobile.preview_image.width,
                widths: mobile_widths,
                height: block_settings.video_mobile.preview_image.height,
                loading: loading,
                class: 'media-slide__video-poster media-slide__video-poster--mobile',
                fetchpriority: fetch_priority
            }}
          {%- endif -%}
          {{
            block_settings.video_mobile
            | video_tag:
              poster: nil,
              autoplay: true,
              loop: true,
              controls: false,
              muted: true,
              class: 'media-slide__video media-slide__video--mobile',
              data-testid: 'media-slide-mobile-video'
          }}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Placeholder if no media {%- endcomment -%}
    {%- if media_type == 'none' -%}
      {%- liquid
        assign modulo_result = block_index | modulo: 2
        assign placeholder_variant = 2 | minus: modulo_result
        assign placeholder_name = 'hero-apparel-' | append: placeholder_variant
      -%}
      {{ placeholder_name | placeholder_svg_tag: 'media-slide__image' }}
    {%- endif -%}
  </div>

  {%- comment -%} Content overlay {%- endcomment -%}
  <div
    class="spacing-style media-slide__content{% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}{% if preview_image or block_settings.toggle_overlay %} background-transparent{% endif %}"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <div
      class="group-block-content
      layout-panel-flex
      layout-panel-flex--{{ block_settings.content_direction }}
      {% if block_settings.vertical_on_mobile %}mobile-column{% endif %}"
      style="{% render 'layout-panel-style', settings: block_settings %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>

  {%- comment -%} Section link {%- endcomment -%}
  {%- if block_settings.link != blank -%}
    <a
      href="{{ block_settings.link }}"
      class="media-slide__link"
      {% if block_settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    ></a>
  {%- endif -%}
{% endcapture %}

{%- capture class -%}
  {%- if block_settings.inherit_color_scheme == false -%}
    color-{{ block_settings.color_scheme }}
  {%- endif -%}
{%- endcapture -%}

{% render 'slideshow-slide',
  index: block_index,
  class: class,
  children: children,
  attributes: block.shopify_attributes
%}

{% stylesheet %}
  .media-slide__content {
    height: 100%;
    position: relative;
    z-index: var(--layer-flat);
  }

  .media-slide__content > * {
    margin: auto;
  }

  .media-slide__content.background-transparent {
    background-color: transparent;
  }

  slideshow-slide > .media-slide__media-container {
    display: flex;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: absolute;
  }

  .media-slide__media-container > placeholder-image,
  .media-slide__media-container > placeholder-image > img {
    width: 100%;
  }

  .media-slide__media-container > .media-slide__image,
  .media-slide__media-container > picture.media-slide__image,
  .media-slide__media-container > picture.media-slide__image > img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .media-slide__video-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .media-slide__video,
  .media-slide__video-poster {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .media-slide__video-poster {
    position: absolute;
    z-index: 1;
  }

  .media-slide__link {
    position: absolute;
    inset: 0;
    z-index: var(--layer-raised);
  }

  /* Mobile/Desktop media visibility */
  .media-slide__image--mobile,
  .media-slide__video--mobile,
  .media-slide__video-wrapper--mobile,
  .media-slide__video-poster--mobile {
    display: none;
  }

  .media-slide__image--desktop,
  .media-slide__video--desktop,
  .media-slide__video-wrapper--desktop,
  .media-slide__video-poster--desktop {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .media-slide__image--desktop,
    .media-slide__video--desktop,
    .media-slide__video-wrapper--desktop,
    .media-slide__video-poster--desktop {
      display: none;
    }

    .media-slide__image--mobile,
    .media-slide__video--mobile,
    .media-slide__video-wrapper--mobile,
    .media-slide__video-poster--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.media_slide",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.desktop_media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_media"
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_media",
      "label": "t:settings.custom_mobile_media",
      "default": false
    },
    {
      "type": "select",
      "id": "media_type_mobile",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image",
      "visible_if": "{{ block.settings.custom_mobile_media }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.custom_mobile_media and block.settings.media_type_mobile == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.custom_mobile_media and block.settings.media_type_mobile == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ block.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.media_slide",
      "settings": {
        "horizontal_alignment_flex_direction_column": "center"
      },
      "blocks": {
        "group": {
          "type": "group",
          "settings": {
            "horizontal_alignment_flex_direction_column": "center",
            "width": "custom",
            "custom_width": 50,
            "width_mobile": "custom",
            "inherit_color_scheme": false,
            "color_scheme": "scheme-6",
            "custom_width_mobile": 85,
            "padding-inline-start": 48,
            "padding-inline-end": 48,
            "padding-block-start": 48,
            "padding-block-end": 48
          },
          "blocks": {
