{% doc %}
  @prompt
    quero gerar um botao de opcao de compra pelo whatsapp
    
    texto do botao: ou se preferir (icone do whatsapp) compre pelo whatsapp, O alinhamento nao está muito bom 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whatsapp-button-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-whatsapp-button__link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    transition: all 0.3s ease;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    text-align: center;
    line-height: 1.4;
  }

  .ai-whatsapp-button__link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.border_hover_color }};
  }

  .ai-whatsapp-button__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-whatsapp-button__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    display: block;
  }

  .ai-whatsapp-button__text-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Estilo "link discreto": acao secundaria, abaixo do botao de carrinho */
  .ai-whatsapp-button--link-{{ ai_gen_id }} .ai-whatsapp-button__link-{{ ai_gen_id }},
  .ai-whatsapp-button--link-{{ ai_gen_id }} .ai-whatsapp-button__link-{{ ai_gen_id }}:hover {
    display: inline-flex;
    padding: 4px 0;
    background-color: transparent;
    border: 0;
    border-radius: 0;
    font-size: {{ block.settings.link_font_size }}px;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    color: {{ block.settings.button_text_color }};
  }

  .ai-whatsapp-button--link-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-whatsapp-button--link-{{ ai_gen_id }} .ai-whatsapp-button__text-{{ ai_gen_id }} {
    gap: 4px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-whatsapp-button--link-{{ ai_gen_id }} .ai-whatsapp-button__link-{{ ai_gen_id }}:hover .ai-whatsapp-button__text-{{ ai_gen_id }} {
    text-decoration-thickness: 2px;
  }

  .ai-whatsapp-button--link-{{ ai_gen_id }} .ai-whatsapp-button__icon-{{ ai_gen_id }} {
    width: {{ block.settings.link_font_size | plus: 2 }}px;
    height: {{ block.settings.link_font_size | plus: 2 }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-whatsapp-button-{{ ai_gen_id }} {
      width: 100%;
    }
    
    .ai-whatsapp-button__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<whatsapp-button-{{ ai_gen_id }}
  class="ai-whatsapp-button-{{ ai_gen_id }}{% if block.settings.display_style == 'link' %} ai-whatsapp-button--link-{{ ai_gen_id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign phone = block.settings.whatsapp_number | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
    
    if product
      assign product_title = product.title
      assign product_url = shop.url | append: product.url
      assign message = block.settings.message_template | replace: '[PRODUTO]', product_title | replace: '[URL]', product_url
    else
      assign message = block.settings.message_template
    endif
    
    assign encoded_message = message | url_encode
    assign whatsapp_url = 'https://wa.me/' | append: phone | append: '?text=' | append: encoded_message
  %}

  <a
    href="{{ whatsapp_url }}"
    class="ai-whatsapp-button__link-{{ ai_gen_id }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ block.settings.button_text }}"
  >
    <span class="ai-whatsapp-button__text-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
      <span class="ai-whatsapp-button__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </span>
    </span>
  </a>
</whatsapp-button-{{ ai_gen_id }}>

<script>
  (function() {
    class WhatsAppButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('whatsapp-button-{{ ai_gen_id }}', WhatsAppButton{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Botão WhatsApp",
  "settings": [
    {
      "type": "header",
      "content": "Configurações do WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Número do WhatsApp",
      "info": "Incluir código do país. Exemplo: 5511999999999",
      "default": "5511999999999"
    },
    {
      "type": "textarea",
      "id": "message_template",
      "label": "Mensagem padrão",
      "info": "Use [PRODUTO] para o nome do produto e [URL] para o link. Funciona apenas em páginas de produto.",
      "default": "Olá! Gostaria de comprar: [PRODUTO] - [URL]"
    },
    {
      "type": "header",
      "content": "Texto do botão"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto",
      "default": "ou se preferir, compre pelo WhatsApp"
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Formato",
      "options": [
        { "value": "link", "label": "Link discreto (ação secundária)" },
        { "value": "button", "label": "Botão" }
      ],
      "default": "link",
      "info": "Use \"Link discreto\" para que o botão de carrinho continue sendo a ação principal."
    },
    {
      "type": "range",
      "id": "link_font_size",
      "label": "Tamanho da fonte do link",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13,
      "visible_if": "{{ block.settings.display_style == 'link' }}"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Fonte",
      "default": "inter_n7"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamanho da fonte",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Tamanho do ícone",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Estilo do botão"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Cor de fundo",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Cor de fundo ao passar o mouse",
      "default": "#128C7E"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Cor do texto ao passar o mouse",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Espaçamento interno",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Arredondamento das bordas",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Largura da borda",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Cor da borda",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "border_hover_color",
      "label": "Cor da borda ao passar o mouse",
      "default": "#128C7E"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largura no desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Botão WhatsApp"
    }
  ]
}
{% endschema %}