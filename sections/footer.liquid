{%- comment -%}
  Rodapé: quatro colunas (marca, atendimento e dois menus) e linha de direitos.
  Fundo na cor de blocos da marca.
{%- endcomment -%}

<footer class="rodape">
  <div class="rodape__inner">
    <div class="rodape__coluna">
      <p class="rodape__marca">{{ section.settings.nome | escape }}</p>
      {%- if section.settings.descricao != blank -%}
        <p class="rodape__texto">{{ section.settings.descricao | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>

    <div class="rodape__coluna">
      {%- if section.settings.titulo_atendimento != blank -%}
        <h2 class="rodape__titulo">{{ section.settings.titulo_atendimento | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.atendimento != blank -%}
        <p class="rodape__texto">{{ section.settings.atendimento | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>

    <nav class="rodape__coluna" aria-label="{{ section.settings.titulo_menu_1 | escape }}">
      <h2 class="rodape__titulo">{{ section.settings.titulo_menu_1 | escape }}</h2>
      <ul class="rodape__lista">
        {%- for link in section.settings.menu_1.links -%}
          <li><a class="rodape__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <nav class="rodape__coluna" aria-label="{{ section.settings.titulo_menu_2 | escape }}">
      <h2 class="rodape__titulo">{{ section.settings.titulo_menu_2 | escape }}</h2>
      <ul class="rodape__lista">
        {%- for link in section.settings.menu_2.links -%}
          <li><a class="rodape__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>

  <div class="rodape__direitos">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. Todos os direitos reservados.</p>
  </div>
</footer>

{% stylesheet %}
  .rodape {
    background-color: var(--cor-bloco);
    color: var(--cor-texto);
    border-top: 1px solid var(--cor-borda);
    padding-inline: 16px;
  }

  .rodape__inner {
    max-width: var(--largura-pagina);
    margin-inline: auto;
    padding-block: 40px 24px;
    display: grid;
    gap: 32px;
  }

  .rodape__coluna {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .rodape__marca {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-weight: var(--fonte-titulo-peso);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .rodape__titulo {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .rodape__texto {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .rodape__lista {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .rodape__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--toque-minimo);
    color: var(--cor-texto);
    text-decoration: none;
  }

  .rodape__link:hover {
    text-decoration: underline;
  }

  .rodape__link:focus-visible {
    outline: 2px solid var(--cor-acento);
    outline-offset: 2px;
  }

  .rodape__direitos {
    max-width: var(--largura-pagina);
    margin-inline: auto;
    padding-block: 16px 24px;
    border-top: 1px solid var(--cor-borda);
    font-size: 0.8125rem;
    color: var(--cor-texto-sec);
  }

  .rodape__direitos p {
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .rodape {
      padding-inline: 32px;
    }

    .rodape__inner {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rodapé",
  "tag": "footer",
  "settings": [
    {
      "type": "header",
      "content": "Marca"
    },
    {
      "type": "text",
      "id": "nome",
      "label": "Nome da loja",
      "default": "Pijamas Bons Sonhos"
    },
    {
      "type": "textarea",
      "id": "descricao",
      "label": "Descrição",
      "default": "Pijamas para toda a família, feitos em Blumenau, SC há quase 30 anos."
    },
    {
      "type": "header",
      "content": "Atendimento"
    },
    {
      "type": "text",
      "id": "titulo_atendimento",
      "label": "Título",
      "default": "Atendimento"
    },
    {
      "type": "textarea",
      "id": "atendimento",
      "label": "Contatos",
      "default": "Blumenau, SC\nEdite telefone e e-mail no editor"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "text",
      "id": "titulo_menu_1",
      "label": "Título do menu 1",
      "default": "Ajuda"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "titulo_menu_2",
      "label": "Título do menu 2",
      "default": "Institucional"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2",
      "default": "footer"
    }
  ],
  "presets": [
    {
      "name": "Rodapé"
    }
  ]
}
{% endschema %}
