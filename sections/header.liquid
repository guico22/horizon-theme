{%- comment -%}
  Cabeçalho da loja. Logo à esquerda, navegação centralizada no desktop,
  ícones à direita. No mobile, a navegação vira um drawer aberto pelo botão de menu.
  Sem app e sem JS externo: o script abaixo é pequeno e só liga o drawer.
  Sem JS, a navegação aparece logo abaixo da barra.
{%- endcomment -%}

<header class="cabecalho" data-cabecalho>
  <div class="cabecalho__barra">
    <button
      type="button"
      class="cabecalho__icone cabecalho__menu-toggle"
      aria-expanded="false"
      aria-controls="cabecalho-navegacao"
      aria-label="Abrir menu"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <a class="cabecalho__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_tag:
            widths: '120, 240, 360',
            sizes: '240px',
            loading: 'eager',
            class: 'cabecalho__logo-imagem',
            width: section.settings.logo.width,
            height: section.settings.logo.height,
            alt: shop.name
        }}
      {%- else -%}
        <span class="cabecalho__logo-texto">{{ section.settings.logo_texto | escape }}</span>
      {%- endif -%}
    </a>

    <nav
      id="cabecalho-navegacao"
      class="cabecalho__nav"
      aria-label="Principal"
      style="--logo-altura: {{ section.settings.logo_altura }}px;"
    >
      <ul class="cabecalho__lista">
        {%- for link in section.settings.menu.links -%}
          <li class="cabecalho__item">
            <a
              class="cabecalho__link"
              href="{{ link.url }}"
              {%- if link.active %} aria-current="page"{% endif -%}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="cabecalho__acoes">
      <a class="cabecalho__icone" href="{{ routes.search_url }}" aria-label="Buscar">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20l-3.5-3.5" />
        </svg>
      </a>

      <a class="cabecalho__icone" href="{{ routes.account_login_url }}" aria-label="Minha conta">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
        </svg>
      </a>

      <a
        class="cabecalho__icone"
        href="{{ routes.cart_url }}"
        aria-label="Sacola, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %}"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 8h14l-1 12H6L5 8Z" />
          <path d="M9 8V6a3 3 0 0 1 6 0v2" />
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cabecalho__contador" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--cor-base);
    border-bottom: 1px solid var(--cor-borda);
    color: var(--cor-texto);
  }

  .cabecalho__barra {
    max-width: var(--largura-pagina);
    margin-inline: auto;
    padding-inline: 8px;
    min-height: 64px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .cabecalho__icone {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--toque-minimo);
    height: var(--toque-minimo);
    padding: 0;
    border: 0;
    border-radius: var(--raio-campo);
    background: none;
    color: var(--cor-texto);
    cursor: pointer;
    text-decoration: none;
  }

  .cabecalho__icone:focus-visible,
  .cabecalho__link:focus-visible,
  .cabecalho__logo:focus-visible {
    outline: 2px solid var(--cor-acento);
    outline-offset: 2px;
  }

  .cabecalho__icone svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cabecalho__menu-toggle {
    display: none;
  }

  .cabecalho--js .cabecalho__menu-toggle {
    display: inline-flex;
  }

  .cabecalho__logo {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--toque-minimo);
    color: var(--cor-texto);
    text-decoration: none;
  }

  .cabecalho__logo-imagem {
    width: auto;
    height: var(--logo-altura, 36px);
  }

  .cabecalho__logo-texto {
    font-family: var(--fonte-titulo);
    font-weight: var(--fonte-titulo-peso);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .cabecalho__acoes {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    order: 3;
  }

  .cabecalho__contador {
    position: absolute;
    top: 4px;
    right: 0;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    border-radius: 999px;
    background-color: var(--cor-acento);
    color: var(--cor-base);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
  }

  /* Sem JS, a navegação fica em linha abaixo da barra. */
  .cabecalho__nav {
    order: 4;
    flex: 0 0 100%;
    border-top: 1px solid var(--cor-borda);
  }

  .cabecalho__lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cabecalho__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--toque-minimo);
    padding-inline: 12px;
    color: var(--cor-texto);
    font-size: 1rem;
    text-decoration: none;
  }

  .cabecalho__link[aria-current='page'] {
    color: var(--cor-acento);
    font-weight: 600;
  }

  .cabecalho__link:hover {
    text-decoration: underline;
  }

  /* Com JS, no mobile, a navegação vira um drawer. */
  .cabecalho--js .cabecalho__nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    order: 0;
    flex: none;
    padding: 8px 16px 16px;
    background-color: var(--cor-base);
    border-top: 0;
    border-bottom: 1px solid var(--cor-borda);
  }

  .cabecalho--js .cabecalho__nav[hidden] {
    display: none;
  }

  .cabecalho--js .cabecalho__lista {
    flex-direction: column;
  }

  .cabecalho__logo {
    order: 2;
  }

  @media screen and (min-width: 990px) {
    .cabecalho__barra {
      flex-wrap: nowrap;
      padding-inline: 32px;
    }

    .cabecalho__logo {
      flex: 0 0 auto;
      justify-content: flex-start;
      order: 1;
    }

    .cabecalho__nav {
      order: 2;
      flex: 1 1 auto;
      border-top: 0;
    }

    .cabecalho__lista {
      justify-content: center;
    }

    .cabecalho__acoes {
      order: 3;
    }

    .cabecalho--js .cabecalho__menu-toggle {
      display: none;
    }

    .cabecalho--js .cabecalho__nav {
      position: static;
      flex: 1 1 auto;
      padding: 0;
      border-bottom: 0;
      background: none;
    }

    .cabecalho--js .cabecalho__nav[hidden] {
      display: block;
    }

    .cabecalho--js .cabecalho__lista {
      flex-direction: row;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const cabecalho = document.querySelector('[data-cabecalho]');
    if (!cabecalho) return;

    const botao = cabecalho.querySelector('.cabecalho__menu-toggle');
    const navegacao = cabecalho.querySelector('.cabecalho__nav');
    if (!botao || !navegacao) return;

    const desktop = window.matchMedia('(min-width: 990px)');

    const definirAberto = (aberto) => {
      botao.setAttribute('aria-expanded', String(aberto));
      botao.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
      navegacao.hidden = !aberto;
    };

    const sincronizar = () => {
      if (desktop.matches) {
        navegacao.hidden = false;
      } else {
        definirAberto(botao.getAttribute('aria-expanded') === 'true');
      }
    };

    cabecalho.classList.add('cabecalho--js');
    definirAberto(false);
    sincronizar();

    botao.addEventListener('click', () => {
      definirAberto(botao.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && botao.getAttribute('aria-expanded') === 'true') {
        definirAberto(false);
        botao.focus();
      }
    });

    desktop.addEventListener('change', sincronizar);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Cabeçalho",
  "tag": "header",
  "settings": [
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_altura",
      "label": "Altura do logo",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "text",
      "id": "logo_texto",
      "label": "Nome sem logo",
      "default": "Pijamas Bons Sonhos"
    }
  ]
}
{% endschema %}
