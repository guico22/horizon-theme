{%- doc -%}
  First-purchase coupon pieces shared by the announcement bar and the product
  page: the code pill and the copy button. Colors come from Theme settings >
  "Cupom de primeira compra".

  @param {string} code - Coupon code
  @param {string} part - 'pill' renders the code; 'copy' renders the copy button
  @param {string} [copy_label] - Copy button text (default: 'Copiar')
  @param {string} [copied_label] - Text shown after copying (default: 'Copiado!')

  @example
  {% render 'coupon-code', code: settings.first_purchase_coupon_code, part: 'pill' %}
{%- enddoc -%}

{%- assign code = code | strip -%}

{%- if code != blank -%}
  {%- if part == 'pill' -%}
    <strong
      class="coupon-code__pill"
      style="--coupon-code-background: {{ settings.coupon_code_background | default: '#915d65' }}; --coupon-code-text: {{ settings.coupon_code_text | default: '#ffffff' }};"
    >
      {{- code | escape -}}
    </strong>
  {%- elsif part == 'copy' -%}
    <script
      src="{{ 'coupon-copy.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <coupon-copy
      class="coupon-code__copy"
      data-code="{{ code | escape }}"
      data-copied-label="{{ copied_label | default: 'Copiado!' | escape }}"
    >
      <button
        type="button"
        class="coupon-code__button"
      >
        <svg
          class="coupon-code__icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="9" y="9" width="11" height="11" rx="2"/>
          <path d="M5 15V6a2 2 0 0 1 2-2h9"/>
        </svg>
        <span data-coupon-copy-label>{{ copy_label | default: 'Copiar' | escape }}</span>
        <span class="visually-hidden">: {{ code | escape }}</span>
      </button>
      <span
        class="visually-hidden"
        role="status"
        data-coupon-copy-status
      ></span>
    </coupon-copy>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .coupon-code__pill {
    display: inline-block;
    padding: 3px 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
    white-space: nowrap;
    color: var(--coupon-code-text);
    background-color: var(--coupon-code-background);
    border-radius: 999px;
  }

  .coupon-code__copy {
    display: inline-flex;
    align-items: center;
  }

  .coupon-code__button {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 28px;
    padding: 2px 10px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    color: inherit;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 999px;
    cursor: pointer;
  }

  .coupon-code__button:hover {
    background-color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-10));
  }

  .coupon-code__button[data-copied] {
    color: var(--color-background);
    background-color: var(--color, var(--color-foreground));
  }

  .coupon-code__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
{% endstylesheet %}
