{%- doc -%}
  Renders the "ou R$ X no Pix" line below a price.

  The discount and texts come from Theme settings > "Preço no Pix". Nothing is
  rendered unless `settings.pix_price_enabled` is on, so the line can be turned
  off whenever the checkout stops honoring the discount.

  The Pix value is rounded up to the cent so the storefront never shows less
  than the checkout charges.

  @param {number} price - Current selling price in cents (never the compare-at price)
  @param {boolean} [is_range] - Use the "a partir de" text (variants with different prices)
  @param {boolean} [use_currency] - Format with `money_with_currency`
  @param {boolean} [compact] - Smaller, single-line version for product cards

  @example
  {% render 'pix-price', price: product.price_min, is_range: product.price_varies %}
{%- enddoc -%}

{%- if settings.pix_price_enabled and price > 0 -%}
{%- liquid
  assign pix_factor = 100 | minus: settings.pix_discount_percent
  assign pix_price = price | times: pix_factor | divided_by: 100.0 | ceil

  if use_currency
    assign pix_price_formatted = pix_price | money_with_currency
  else
    assign pix_price_formatted = pix_price | money
  endif
  assign pix_price_html = pix_price_formatted | prepend: '<strong class="pix-price__value">' | append: '</strong>'

  if is_range
    assign pix_text = settings.pix_price_range_text | default: 'ou a partir de [valor] no Pix'
  else
    assign pix_text = settings.pix_price_text | default: 'ou [valor] no Pix'
  endif
-%}

<span class="pix-price{% if compact %} pix-price--compact{% endif %}">
  <span class="pix-price__icon">{% render 'icon-pix' %}</span>
  <span class="pix-price__text">
    {{- pix_text | escape | replace: '[valor]', pix_price_html -}}
  </span>
</span>
{%- endif -%}

{% stylesheet %}
  /* Pix is the highlighted price: big, bold value; the rest of the line is a quiet label */
  .pix-price {
    display: flex;
    align-items: center;
    justify-content: var(--pix-price-justify, flex-start);
    gap: 0.4em;
    margin-block-start: 4px;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: var(--font-body--weight);
    font-style: normal;
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: none;
    white-space: normal;
    text-wrap: balance;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  /* Follow the alignment of the surrounding price (centered cards, etc.) */
  .text-center .pix-price,
  .text-block--align-center .pix-price {
    --pix-price-justify: center;
  }

  .text-right .pix-price,
  .text-block--align-right .pix-price {
    --pix-price-justify: flex-end;
  }

  .pix-price__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
    color: var(--color-foreground);
  }

  .pix-price__icon svg {
    width: 100%;
    height: 100%;
  }

  .pix-price__text {
    min-width: 0;
  }

  .pix-price__value {
    font-size: 1.75em;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--color-foreground);
    vertical-align: -0.08em;
  }

  /* Product cards */
  .pix-price--compact {
    gap: 0.3em;
    margin-block-start: 2px;
    font-size: 0.75rem;
  }

  .pix-price--compact .pix-price__value {
    font-size: 1.5em;
  }

  /* Regular price becomes secondary when the Pix price is shown */
  .price-with-pix .price {
    font-size: 0.8em;
    font-weight: 400;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .price-with-pix .compare-at-price {
    font-size: 0.75em;
  }

  .price-with-pix--compact .price {
    font-size: 0.8125rem;
  }

  .price-with-pix--compact .compare-at-price {
    font-size: 0.75rem;
  }

  @media screen and (max-width: 749px) {
    .pix-price--compact {
      font-size: 0.6875rem;
    }
  }
{% endstylesheet %}
